# =============================================================================
# Files and folders git (and the submission zip) should ignore.
# =============================================================================

# --- Python bytecode / caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor junk ---
.vscode/
.idea/
*.swp
*.swo

# --- Big generated files (recreate with `bash run_all.sh`) ---
# You may want to SHIP these for grading — if so, remove these lines.
# By default we ship them (they are required by the rubric).
# models/*.keras
# reports/figures/*.png
# reports/tables/*.csv

# --- Downloaded datasets (Keras caches CIFAR-10 here) ---
~/.keras/
# Local cache directory if CIFAR-10 ends up here
data/cifar10_cache/

# --- Jupyter notebook checkpoints ---
.ipynb_checkpoints/

# --- Log files ---
*.log

# --- Keras-Tuner search cache (if you ever try keras-tuner) ---
tuner_dir/
